{
  "name": "Sara - E-commerce Platform",
  "short_name": "Sara",
  "start_url": "/index.html",
  "display": "standalone",
  "background_color": "#ffffff",
  "theme_color": "#000000",
  "icons": [
    { "src": "/images/newlogo.svg", "sizes": "192x192", "type": "image/png" },
    { "src": "/images/newlogo.svg", "sizes": "512x512", "type": "image/png" }
  ],
  "share_target": {
    "action": "/visual-search.html",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "image",
          "accept": ["image/*"]
        }
      ]
    }
  }
}
